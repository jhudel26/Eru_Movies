# ERU Cinema - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# TMDB API Key - Get yours at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Custom Vidy base URL (if mirroring)
# VIDY_BASE=https://www.vidy.st

# Optional: Electron development settings
# NODE_ENV=development