{
  "name": "eru-desktop",
  "version": "1.0.0",
  "description": "ERU - Cinema Movies & TV Shows Desktop Streaming Platform",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n \"VITE,ELECTRON\" -c \"cyan,teal\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "installer": "npm run build && npx electron-builder --dir && \"C:\\Program Files (x86)\\Inno Setup 6\\ISCC.exe\" installer.iss",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext ts,tsx --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\""
  },
  "build": {
    "appId": "com.eru.desktop",
    "productName": "ERU",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "movies",
    "tv-shows",
    "streaming",
    "cinema",
    "desktop",
    "electron",
    "react"
  ],
  "author": "jhudel26",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^2.0.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.7.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.3",
    "vitest": "^2.0.0",
    "wait-on": "^9.0.4"
  }
}
